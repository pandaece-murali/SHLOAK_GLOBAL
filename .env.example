# ==============================================================================
# SHLOKA GLOBAL EDUCATION - ENVIRONMENT CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. EMAIL NOTIFICATIONS VIA SMTP (GMAIL APP PASSWORD)
# ------------------------------------------------------------------------------
# SMTP Server settings (Default: Gmail)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true

# The Gmail account sending the emails
SMTP_USER=your-email@gmail.com

# 16-character Google App Password (NOT your regular Gmail password)
# How to get it:
# 1. Go to https://myaccount.google.com/security
# 2. Turn on "2-Step Verification" (if not already enabled)
# 3. Search for "App Passwords" or go to https://myaccount.google.com/apppasswords
# 4. Create a new app password (e.g. name it "Shloka Leads")
# 5. Paste the 16-character password below (without spaces):
SMTP_PASS=abcdefghijklmnop

# Sender display name and email address
EMAIL_FROM="Shloka Global Admissions" <your-email@gmail.com>

# Primary recipient email where lead notifications will be sent
EMAIL_TO=admissions@shlokaglobaleducation.com

# Optional CC email recipients (comma-separated for multiple)
EMAIL_CC=counsellor@shlokaglobaleducation.com,director@shlokaglobaleducation.com

# Optional BCC email recipients (comma-separated for multiple)
EMAIL_BCC=leads-backup@shlokaglobaleducation.com

# ------------------------------------------------------------------------------
# 2. GOOGLE SHEETS INTEGRATION
# ------------------------------------------------------------------------------
# Deploy a Google Apps Script Web App on your Google Sheet and paste the URL here.
# (See instructions in GOOGLE_SHEET_SETUP.md or README.md)
GOOGLE_SHEET_WEBHOOK_URL=https://script.google.com/macros/s/YOUR_APPS_SCRIPT_ID/exec

# ------------------------------------------------------------------------------
# 3. META ADS & EXTERNAL WEBHOOKS
# ------------------------------------------------------------------------------
# Meta Pixel ID for tracking PageView and Lead events
NEXT_PUBLIC_META_PIXEL_ID=

# Optional secondary webhook (e.g. GoHighLevel CRM)
NEXT_PUBLIC_LEAD_WEBHOOK_URL=
